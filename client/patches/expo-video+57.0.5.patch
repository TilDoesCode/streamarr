@@ -0,0 +1,57 @@
+// Streamarr: keeps subtitle cues above the app's control bar while it shows (F13n, Q2-02).
+
+package expo.modules.video.utils
+
+import android.view.View
+import androidx.annotation.OptIn
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.ui.PlayerView
+import androidx.media3.ui.SubtitleView
+import java.lang.ref.WeakReference
+import java.util.WeakHashMap
+
+@OptIn(UnstableApi::class)
+object SubtitleLift {
+  private val lifts = WeakHashMap<PlayerView, Lift>()
+
+  /** `lift`: the bottom share of the player view the cues must stay above; 0 puts them back in their own place. */
+  fun apply(playerView: PlayerView, lift: Double) {
+    val subtitles = playerView.subtitleView ?: return
+    val state = lifts.getOrPut(playerView) {
+      Lift(WeakReference(playerView)).also { subtitles.addOnLayoutChangeListener(it) }
+    }
+    state.value = lift
+    place(playerView, subtitles, lift)
+  }
+
+  // WebVTT cues carry line -1 (bottom edge, no bottomPaddingFraction): the SubtitleView's padding moves every cue.
+  private fun place(playerView: PlayerView, subtitles: SubtitleView, lift: Double) {
+    val height = subtitles.height
+    var padding = 0
+    if (lift > 0.0 && height > 0) {
+      val viewAt = IntArray(2).also { playerView.getLocationInWindow(it) }
+      val subtitlesAt = IntArray(2).also { subtitles.getLocationInWindow(it) }
+      val barTop = playerView.height * (1.0 - lift) - (subtitlesAt[1] - viewAt[1])
+      val covered = (height - barTop).coerceIn(0.0, height * MAX_SHARE)
+      if (covered > 0.0) padding = (covered + height * GAP).toInt()
+    }
+    if (subtitles.paddingBottom != padding) {
+      subtitles.setPadding(subtitles.paddingLeft, subtitles.paddingTop, subtitles.paddingRight, padding)
+    }
+  }
+
+  /** The picture changes size (aspect ratio known, content fit, rotation): the cues keep their place above the bar. */
+  private class Lift(private val playerView: WeakReference<PlayerView>) : View.OnLayoutChangeListener {
+    var value = 0.0
+
+    override fun onLayoutChange(
+      view: View, left: Int, top: Int, right: Int, bottom: Int,
+      oldLeft: Int, oldTop: Int, oldRight: Int, oldBottom: Int
+    ) {
+      playerView.get()?.let { place(it, view as SubtitleView, value) }
+    }
+  }
+
+  private const val MAX_SHARE = 0.8
+  private const val GAP = 0.015
+}
