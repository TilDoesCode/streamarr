diff --git a/node_modules/expo-video/ios/VideoPlayerHealth.swift b/node_modules/expo-video/ios/VideoPlayerHealth.swift
new file mode 100644
index 0000000..5db0b15
--- /dev/null
+++ b/node_modules/expo-video/ios/VideoPlayerHealth.swift
@@ -0,0 +1,218 @@
+// Streamarr: health probe and system-pause causes for the player watchdog (patches/expo-video).
+
+import AVFoundation
+import UIKit
+import ExpoModulesCore
+#if os(iOS)
+import CallKit
+#endif
+
+internal final class VideoPlayerHealth {
+  private weak var owner: VideoPlayer?
+  private var observers: [NSObjectProtocol] = []
+  private var videoOutput: AVPlayerItemVideoOutput?
+  private weak var videoOutputItem: AVPlayerItem?
+  private var framesPresented = 0
+  private weak var errorLogItem: AVPlayerItem?
+  private var errorLogReported = 0
+  #if os(iOS)
+  private let callObserver = CXCallObserver()
+  private var protectedDataLostAt = Date.distantPast
+  #endif
+
+  init(owner: VideoPlayer) {
+    self.owner = owner
+    let center = NotificationCenter.default
+    observers.append(center.addObserver(forName: AVAudioSession.interruptionNotification, object: nil, queue: .main) { [weak self] note in
+      self?.onInterruption(note)
+    })
+    observers.append(center.addObserver(forName: AVAudioSession.routeChangeNotification, object: nil, queue: .main) { [weak self] note in
+      self?.onRouteChange(note)
+    })
+    observers.append(center.addObserver(forName: AVPlayerItem.newErrorLogEntryNotification, object: nil, queue: .main) { [weak self] note in
+      self?.onErrorLogEntry(note)
+    })
+    #if os(iOS)
+    observers.append(center.addObserver(forName: UIApplication.protectedDataWillBecomeUnavailableNotification, object: nil, queue: .main) { [weak self] _ in
+      self?.protectedDataLostAt = Date()
+    })
+    #endif
+  }
+
+  deinit {
+    observers.forEach { NotificationCenter.default.removeObserver($0) }
+  }
+
+  /// One sample for the watchdog; main thread. `withFrames` attaches an AVPlayerItemVideoOutput to count new frames.
+  func read(withFrames: Bool) -> [String: Any] {
+    guard let owner, let item = owner.ref.currentItem else {
+      return [:]
+    }
+    var health: [String: Any] = ["nativePosition": owner.currentTime]
+    if withFrames {
+      if videoOutputItem !== item {
+        if let output = videoOutput, let oldItem = videoOutputItem {
+          oldItem.remove(output)
+        }
+        let output = AVPlayerItemVideoOutput(pixelBufferAttributes: nil)
+        item.add(output)
+        videoOutput = output
+        videoOutputItem = item
+        framesPresented = 0
+      }
+      if let output = videoOutput {
+        let time = output.itemTime(forHostTime: CACurrentMediaTime())
+        if output.hasNewPixelBuffer(forItemTime: time), output.copyPixelBuffer(forItemTime: time, itemTimeForDisplay: nil) != nil {
+          framesPresented += 1
+        }
+        health["framesPresented"] = framesPresented
+      }
+    }
+    if let ready = VideoManager.shared.isReadyForDisplay(player: owner) {
+      health["readyForDisplay"] = ready
+    }
+    let tracks = item.tracks.filter { $0.isEnabled }
+    if !tracks.isEmpty {
+      let hasVideo = tracks.contains { $0.assetTrack?.mediaType == .video }
+      let hasAudio = tracks.contains { $0.assetTrack?.mediaType == .audio }
+      health["hasVideoTrack"] = hasVideo
+      health["hasAudioTrack"] = hasAudio
+      // AVPlayer has no audio counter: video without any enabled audio track is the one silence it shows.
+      if hasVideo && !hasAudio {
+        health["audioProgress"] = 0
+      }
+    }
+    if let bitrate = item.accessLog()?.events.last?.observedBitrate, bitrate > 0 {
+      health["bandwidthBps"] = bitrate
+    }
+    health["external"] = owner.ref.isExternalPlaybackActive
+    if let airplay = AVAudioSession.sharedInstance().currentRoute.outputs.first(where: { $0.portType == .airPlay }) {
+      health["externalDevice"] = airplay.portName
+    }
+    return health
+  }
+
+  /// expo-video pauses a player that is not in picture-in-picture when the app leaves the foreground.
+  func willPauseForBackground() {
+    if owner?.ref.rate != 0 {
+      emit(paused: true, cause: screenLocked() ? "locked" : "background")
+    }
+  }
+
+  /// A lock is only visible when the device has a passcode (protected data goes away); otherwise it reads as background.
+  private func screenLocked() -> Bool {
+    #if os(iOS)
+    return !UIApplication.shared.isProtectedDataAvailable
+      || Date().timeIntervalSince(protectedDataLostAt) < 2
+    #else
+    return false
+    #endif
+  }
+
+  private func onInterruption(_ note: Notification) {
+    guard let info = note.userInfo, let rawType = info[AVAudioSessionInterruptionTypeKey] as? UInt,
+      let type = AVAudioSession.InterruptionType(rawValue: rawType) else {
+      return
+    }
+    if type == .began {
+      var cause = callActive() ? "call" : "otherAudio"
+      if #available(iOS 14.5, tvOS 14.5, *),
+        let rawReason = info[AVAudioSessionInterruptionReasonKey] as? UInt,
+        AVAudioSession.InterruptionReason(rawValue: rawReason) == .appWasSuspended {
+        cause = screenLocked() ? "locked" : "background"
+      }
+      emitIfStopped(cause: cause)
+    } else if let rawOptions = info[AVAudioSessionInterruptionOptionKey] as? UInt,
+      AVAudioSession.InterruptionOptions(rawValue: rawOptions).contains(.shouldResume) {
+      emit(paused: false, cause: "resume")
+    }
+  }
+
+  private func onRouteChange(_ note: Notification) {
+    guard let info = note.userInfo, let rawReason = info[AVAudioSessionRouteChangeReasonKey] as? UInt,
+      AVAudioSession.RouteChangeReason(rawValue: rawReason) == .oldDeviceUnavailable else {
+      return
+    }
+    let previous = info[AVAudioSessionRouteChangePreviousRouteKey] as? AVAudioSessionRouteDescription
+    let airplay = previous?.outputs.contains { $0.portType == .airPlay } ?? false
+    emitIfStopped(cause: airplay ? "airplayLost" : "headphones")
+  }
+
+  /// AVPlayer pauses on its own for these; only a player that really stopped is reported.
+  private func emitIfStopped(cause: String) {
+    DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) { [weak self] in
+      if self?.owner?.ref.rate == 0 {
+        self?.emit(paused: true, cause: cause)
+      }
+    }
+  }
+
+  /// Failed requests of the current item (subtitle or audio rendition, segment): every new entry once, in order (R2).
+  private func onErrorLogEntry(_ note: Notification) {
+    guard let owner, let item = note.object as? AVPlayerItem, item === owner.ref.currentItem,
+      let events = item.errorLog()?.events else {
+      return
+    }
+    if errorLogItem !== item {
+      errorLogItem = item
+      errorLogReported = 0
+    }
+    // A log that ever got shorter than what was reported restarts at its newest entry.
+    if events.count < errorLogReported {
+      errorLogReported = max(0, events.count - 1)
+    }
+    let fresh = events[errorLogReported...]
+    errorLogReported = events.count
+    for event in fresh {
+      owner.safeEmit(event: "loadError", payload: LoadErrorPayload(
+        uri: event.uri,
+        trackType: "other",
+        status: Self.httpStatus(event),
+        domain: event.errorDomain,
+        code: event.errorStatusCode,
+        comment: event.errorComment
+      ))
+    }
+  }
+
+  /// The HTTP status of a failed request: the code itself, "HTTP 404" in the comment, or CoreMedia's 404/403 codes.
+  static func httpStatus(_ event: AVPlayerItemErrorLogEvent) -> Int? {
+    if (400...599).contains(event.errorStatusCode) {
+      return event.errorStatusCode
+    }
+    if let comment = event.errorComment, let range = comment.range(of: "HTTP [0-9]{3}", options: .regularExpression) {
+      return Int(comment[range].dropFirst(5))
+    }
+    switch event.errorStatusCode {
+    case -12938: return 404
+    case -12660: return 403
+    default: return nil
+    }
+  }
+
+  private func emit(paused: Bool, cause: String) {
+    owner?.safeEmit(event: "systemPlayback", payload: SystemPlaybackPayload(paused: paused, cause: cause))
+  }
+
+  private func callActive() -> Bool {
+    #if os(iOS)
+    return callObserver.calls.contains { !$0.hasEnded }
+    #else
+    return false
+    #endif
+  }
+}
+
+internal struct LoadErrorPayload: Record {
+  @Field var uri: String? = nil
+  @Field var trackType: String = "other"
+  @Field var status: Int? = nil
+  @Field var domain: String? = nil
+  @Field var code: Int? = nil
+  @Field var comment: String? = nil
+}
+
+internal struct SystemPlaybackPayload: Record {
+  @Field var paused: Bool = false
+  @Field var cause: String = ""
+}
