+++ b/node_modules/expo-video/ios/VideoPlayerSubtitleLift.swift
@@ -0,0 +1,67 @@
+// Streamarr: keeps subtitle cues above the app's control bar while it shows (F13n, Q2-02).
+
+import AVKit
+import CoreMedia
+
+extension VideoPlayer {
+  /// AVFoundation puts the cue's top at the line position: room for two lines of a cue plus a small gap above the bar.
+  private static let cueGapPercent = 13.0
+
+  /// The item's text style rules place cues drawn from now on (a cue on screen keeps its place until it ends); nil = default.
+  func applySubtitleLift() {
+    guard Thread.isMainThread else {
+      DispatchQueue.main.async { [weak self] in self?.applySubtitleLift() }
+      return
+    }
+    guard let item = ref.currentItem else {
+      return
+    }
+    let key = kCMTextMarkupAttribute_OrthogonalLinePositionPercentageRelativeToWritingDirection as String
+    let line = subtitleLine()
+    let current = item.textStyleRules?.first?.textMarkupAttributes[key] as? Double
+    guard line != current else {
+      return
+    }
+    item.textStyleRules = line.flatMap { AVTextStyleRule(textMarkupAttributes: [key: $0]) }.map { [$0] }
+  }
+
+  /// The cue's top in percent of the picture: above the bar by the gap, but never above the ceiling (short windows, Q2-12).
+  private func subtitleLine() -> Double? {
+    guard subtitleLift > 0 else {
+      return nil
+    }
+    guard let picture = pictureFrame() else {
+      return max(0, (1 - subtitleLift) * 100 - Self.cueGapPercent)
+    }
+    let barTop = Double(picture.view.height) * (1 - subtitleLift)
+    let share = min(0.8, max(0, (Double(picture.frame.maxY) - barTop) / Double(picture.frame.height)))
+    guard share > 0 else {
+      return nil
+    }
+    var line = max(0, (1 - share) * 100 - Self.cueGapPercent)
+    if subtitleCeiling > 0 {
+      let ceiling = (Double(picture.view.height) * subtitleCeiling - Double(picture.frame.minY)) / Double(picture.frame.height) * 100
+      line = max(line, min(ceiling, (1 - share) * 100))
+    }
+    return line
+  }
+
+  /// The picture inside the view showing this player (a letterbox makes it smaller than the view).
+  private func pictureFrame() -> (view: CGRect, frame: CGRect)? {
+    let views = VideoManager.shared.videoViews(of: self)
+    guard let view = views.first(where: { $0.window != nil }) ?? views.first,
+      let size = ref.currentItem?.presentationSize, size.width > 0, size.height > 0
+    else {
+      return nil
+    }
+    let bounds = view.bounds
+    let fit = view.playerViewController.videoGravity == .resizeAspectFill
+      ? max(bounds.width / size.width, bounds.height / size.height)
+      : min(bounds.width / size.width, bounds.height / size.height)
+    let height = size.height * fit
+    guard bounds.height > 0, height > 0 else {
+      return nil
+    }
+    return (bounds, CGRect(x: 0, y: bounds.midY - height / 2, width: size.width * fit, height: height))
+  }
+}
