{
  "$schema": "../../codecraft/packages/shared/actions.schema.json",
  "actions": [
    {
      "id": "plugin-build",
      "label": "Build Jellyfin Plugin",
      "group": "build",
      "command": "dotnet",
      "args": [
        "build",
        "plugin/Streamarr.Plugin/Streamarr.Plugin.csproj",
        "-c",
        "Release"
      ],
      "shell": true,
      "env": {
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
      }
    },
    {
      "id": "tunnel-helper-build",
      "label": "Build VPN tunnel helper (streamarr-tunnel, needs Go)",
      "group": "build",
      "command": "bash",
      "args": ["server/scripts/build-tunnel-helper.sh"],
      "shell": false,
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/go/bin:${PATH}"
      }
    },
    {
      "id": "stack",
      "label": "Full Testing Stack (Jellyfin + Core Server + Web)",
      "group": "dev",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "docker-compose.dev.yml",
        "--profile",
        "web",
        "up",
        "--build"
      ],
      "shell": true,
      "env": {
        "PLUGIN_TFM": "net9.0",
        "STREAMARR_ADMIN_USERNAME": "admin",
        "STREAMARR_ADMIN_PASSWORD": "streamarr-dev",
        "STREAMARR_API_KEY": "dev-streamarr-api-key-change-me-0123456789"
      },
      "appName": {
        "streamarr": { "port": 39080, "portEnv": "STREAMARR_PORT" },
        "jellyfin": { "port": 39096, "portEnv": "JELLYFIN_PORT" },
        "web": { "port": 39173, "portEnv": "STREAMARR_WEB_PORT" }
      }
    },
    {
      "id": "stack-down",
      "label": "Stop Testing Stack (remove containers)",
      "group": "other",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "docker-compose.dev.yml",
        "--profile",
        "web",
        "down",
        "--remove-orphans"
      ],
      "shell": true,
      "env": {
        "PLUGIN_TFM": "net9.0",
        "STREAMARR_ADMIN_USERNAME": "admin",
        "STREAMARR_ADMIN_PASSWORD": "streamarr-dev",
        "STREAMARR_API_KEY": "dev-streamarr-api-key-change-me-0123456789"
      }
    },
    {
      "id": "server",
      "label": "Core Server (native dev)",
      "group": "dev",
      "command": "sh",
      "args": [
        "-c",
        "mkdir -p /tmp/streamarr-dev/keys && exec env Streamarr__TrustedOrigins__0=\"${CODECRAFT_URL_WEB_DEV:-}\" dotnet run --no-launch-profile --project src/Streamarr.Server/Streamarr.Server.csproj"
      ],
      "cwd": "./server",
      "shell": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "Streamarr__ApiKey": "dev-streamarr-api-key-change-me-0123456789",
        "Streamarr__Admin__Username": "admin",
        "Streamarr__Admin__Password": "streamarr-dev",
        "Streamarr__ConnectionString": "Data Source=/tmp/streamarr-dev/streamarr.db",
        "Streamarr__DataProtectionKeysPath": "/tmp/streamarr-dev/keys"
      },
      "appName": {
        "server": { "port": 39190, "portEnv": "ASPNETCORE_HTTP_PORTS" }
      }
    },
    {
      "id": "devworld",
      "label": "Dev World (Core Server + mock Usenet/TMDB for the viewer client)",
      "group": "dev",
      "command": "bash",
      "args": ["scripts/devworld.sh", "run"],
      "shell": false,
      "env": {
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
      },
      "appName": {
        "devworld": { "port": 39300, "portEnv": "DEVWORLD_PORT" }
      }
    },
    {
      "id": "web",
      "label": "Management UI (native dev)",
      "group": "dev",
      "command": "sh",
      "args": [
        "-c",
        "STREAMARR_SERVER_ORIGIN=\"${CODECRAFT_URL_SERVER:-http://localhost:39190}\" exec npm run dev -- --host --port \"$PORT\""
      ],
      "cwd": "./web",
      "shell": true,
      "appName": {
        "web-dev": { "port": 39191, "portEnv": "PORT" }
      }
    },
    {
      "id": "client-web",
      "label": "Viewer Client (Expo web)",
      "group": "dev",
      "command": "sh",
      "args": [
        "-c",
        "exec npx expo start --web --port \"${PORT:-39301}\""
      ],
      "cwd": "./client",
      "shell": false,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "appName": {
        "client-web": { "port": 39301, "portEnv": "PORT" }
      }
    },
    {
      "id": "client-metro",
      "label": "Viewer Client Metro (dev builds: Android/Google TV, iOS/tvOS)",
      "group": "dev",
      "command": "sh",
      "args": [
        "-c",
        "exec npx expo start --dev-client --port \"${RCT_METRO_PORT:-8081}\""
      ],
      "cwd": "./client",
      "shell": false,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "appName": {
        "client-metro": { "port": 8081, "portEnv": "RCT_METRO_PORT" }
      }
    },
    {
      "id": "client-ipa",
      "label": "Viewer Client iOS IPA (local, unsigned, for sideloading)",
      "group": "build",
      "command": "bash",
      "args": ["scripts/build-ipa.sh"],
      "cwd": "./client",
      "shell": false,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      }
    },
    {
      "id": "client-ios-release",
      "label": "Viewer Client iOS Release (EAS build → GitHub release → AltStore source)",
      "group": "build",
      "command": "node",
      "args": ["scripts/release-ios.mjs"],
      "cwd": "./client",
      "shell": false,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "inputs": [
        {
          "name": "RELEASE_NOTES",
          "label": "Release notes",
          "type": "string",
          "multiline": true,
          "description": "Shown in AltStore/SideStore and on the GitHub release."
        },
        {
          "name": "EAS_BUILD_ID",
          "label": "Existing EAS build ID (optional)",
          "type": "string",
          "description": "Publish a finished EAS build instead of starting a new one."
        }
      ]
    },
    {
      "id": "client-ota",
      "label": "Viewer Client OTA Update (EAS Update, channel production)",
      "group": "build",
      "command": "sh",
      "args": ["-c", "exec bash scripts/publish-ota.sh \"$UPDATE_MESSAGE\" \"$UPDATE_PLATFORM\""],
      "cwd": "./client",
      "shell": false,
      "env": {
        "EXPO_NO_TELEMETRY": "1"
      },
      "inputs": [
        {
          "name": "UPDATE_MESSAGE",
          "label": "Update message",
          "type": "string",
          "required": true
        },
        {
          "name": "UPDATE_PLATFORM",
          "label": "Platform",
          "type": "select",
          "options": ["ios", "android", "all"],
          "default": "all",
          "description": "Only installs whose native runtime (fingerprint) matches receive the update."
        }
      ]
    },
    {
      "id": "test-server",
      "label": "Server Tests (.NET)",
      "group": "test",
      "command": "dotnet",
      "args": ["test", "server/Streamarr.sln", "-c", "Release"],
      "shell": true,
      "env": {
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
      }
    },
    {
      "id": "test-jellyfin",
      "label": "Jellyfin Plugin E2E (isolated)",
      "group": "test",
      "command": "bash",
      "args": [
        "-lc",
        "dotnet build plugin/Streamarr.Plugin/Streamarr.Plugin.csproj -c Release && exec bash plugin/scripts/smoke-jellyfin.sh"
      ],
      "shell": false,
      "env": {
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
      }
    },
    {
      "id": "test-web",
      "label": "Web Unit Tests (Vitest)",
      "group": "test",
      "command": "npm",
      "args": ["test"],
      "cwd": "./web",
      "shell": true
    },
    {
      "id": "e2e",
      "label": "Web E2E (Playwright + real Core Server)",
      "group": "test",
      "command": "npm",
      "args": ["run", "e2e"],
      "cwd": "./web",
      "shell": true,
      "env": {
        "E2E_ADMIN_PASSWORD": "streamarr-e2e"
      },
      "appName": {
        "e2e": { "port": 39099, "portEnv": "E2E_PORT" }
      }
    }
  ]
}
