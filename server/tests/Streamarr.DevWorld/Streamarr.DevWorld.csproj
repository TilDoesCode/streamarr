<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Two instances may run next to each other on an 8 GB machine: keep the heap small. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Streamarr.Server\Streamarr.Server.csproj" />
    <ProjectReference Include="..\..\src\Streamarr.Core\Streamarr.Core.csproj" />
    <ProjectReference Include="..\..\src\Streamarr.Usenet\Streamarr.Usenet.csproj" />
    <ProjectReference Include="..\Streamarr.Tests.Shared\Streamarr.Tests.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="cache\**" />
    <None Remove="cache\**" />
    <Compile Remove="cache\**" />
    <None Remove="tools\**" />
  </ItemGroup>

</Project>
